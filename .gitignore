# Python
.venv/
__pycache__/
*.pyc

# ESP-IDF build output and fetched components (regenerated by `idf.py
# build` from dependencies.lock -- not source)
firmware/*/build/
firmware/*/managed_components/

# Local ESP-IDF config -- accumulates real WiFi credentials via
# menuconfig (see sdkconfig.defaults for the template with those blanked
# out). sdkconfig.local is ESP-IDF's own supported override file for
# exactly this, if you want one.
firmware/*/sdkconfig
firmware/*/sdkconfig.local

# esp_csi_tool GUI's own local state -- also picks up a real router
# SSID/password when used, and is regenerated on first run anyway.
firmware/*/tools/config/gui_config.json

# Secrets -- SPECTRUM_PIHOLE_PASSWORD etc. live in .env next to
# docker-compose.yml on the Pi, never in the repo
.env
*.env

# OS/editor cruft
.DS_Store
